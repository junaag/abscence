{
  "name": "absence-game",
  "version": "0.2.0-dev.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run integrity && npm run typecheck && npm run build:bundle",
    "build:bundle": "vite build && npm run budget",
    "budget": "node scripts/check-build-budget.mjs",
    "integrity": "node scripts/check-source-integrity.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint src tests scripts vite.config.ts playwright.config.ts",
    "ci": "npm run integrity && npm run typecheck && npm run lint && npm run test && npm run build:bundle"
  },
  "dependencies": {
    "leaflet": "1.9.4"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/leaflet": "1.9.21",
    "eslint": "9.39.5",
    "typescript": "6.0.3",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "@eslint/js": "9.39.5",
    "typescript-eslint": "8.65.0"
  }
}
